{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "dist-*/**",
    "shots/**",
    "playwright-report/**",
    "test-results/**",
    "test-results-*/**"
  ]
}
